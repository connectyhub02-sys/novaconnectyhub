[Unit]
Description=Isolated Betel Chromium collector
After=docker.service betel-browser-firewall.service
Requires=docker.service betel-browser-firewall.service
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
ExecStart=/usr/bin/docker compose -f /opt/betel-isolated-rehearsal/browser-worker/compose.yml up --no-deps --abort-on-container-exit --exit-code-from browser-worker browser-worker
ExecStop=/usr/bin/docker compose -f /opt/betel-isolated-rehearsal/browser-worker/compose.yml stop -t 10 browser-worker
Restart=on-failure
RestartSec=5
TimeoutStartSec=90
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
