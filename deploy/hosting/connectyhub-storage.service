[Unit]
Description=Read-only storage accounting for reviewed customer infrastructure
After=docker.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/connectyhub/hosting/storage.py
TimeoutStartSec=1200
Nice=19
IOSchedulingClass=idle
CPUQuota=50%
MemoryMax=384M
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/connectyhub/monitoring/public
UMask=0022
